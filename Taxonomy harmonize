#!/usr/bin/env Rscript

# Prepare taxonomy reference tables before GBIF name matching.
# This script does not filter to one bird family and does not match GBIF records.
#
# Inputs:
#   1. BirdLife/HBW checklist Excel
#   2. eBird/Clements CSV
#   3. Avibase bibliographic Excel
#
# Outputs:
#   1. birdlife_reference.tsv
#   2. avibase_reference.tsv
#
# Matching logic:
#   - BirdLife/HBW is the target taxonomy.
#   - BirdLife species names, subspecies names, and synonyms are stored in one
#     searchable column: search_name.
#   - eBird/Clements and Avibase names are also stored in one searchable column:
#     search_name.
#   - avibase_id links names across Avibase checklist sheets.
#   - hbw_birdlife_name_code is attached through avibase_id and is carried
#     forward for later GBIF-to-BirdLife harmonization.

library(data.table)
library(readxl)

# 1. Paths --------------------------------------------------------------------

taxonomy_dir <- Sys.getenv(
  "TAXONOMY_SOURCE_DIR",
  file.path("/scratch", Sys.getenv("USER"), "island_bird_project", "gbif", "taxonomy")
)

birdlife_file <- Sys.getenv(
  "BIRDLIFE_XLSX",
  file.path(
    taxonomy_dir,
    "Handbook of the Birds of the World and BirdLife International Digital Checklist of the Birds of the World_Version_10.xlsx"
  )
)

clements_file <- Sys.getenv(
  "CLEMENTS_CSV",
  file.path(taxonomy_dir, "eBird-Clements_v2025-integrated-checklist-October-2025.csv")
)

avibase_file <- Sys.getenv(
  "AVIBASE_XLSX",
  file.path(taxonomy_dir, "avibase_data_bibliographic_2025_v1.xlsx")
)

out_dir <- Sys.getenv(
  "TAXONOMY_CLEAN_OUT_DIR",
  taxonomy_dir
)
dir.create(out_dir, recursive = TRUE, showWarnings = FALSE)

birdlife_reference_file <- file.path(out_dir, "birdlife_reference.tsv")
avibase_reference_file <- file.path(out_dir, "avibase_reference.tsv")

unlink(file.path(
  out_dir,
  c(
    "birdlife_taxa_clean.tsv",
    "birdlife_names_clean.tsv",
    "taxonomy_source_names_clean.tsv",
    "ebird_clements_names_clean.tsv",
    "avibase_names_clean.tsv",
    "avibase_id_source_bridge.tsv",
    "taxonomy_cleaning_data_dictionary.tsv",
    "taxonomy_cleaning_summary.tsv"
  )
))

# 2. Helpers ------------------------------------------------------------------

clean_name <- function(x) {
  x <- as.character(x)
  x[is.na(x)] <- NA_character_
  x <- gsub("\\s+", " ", trimws(x))
  x[x == ""] <- NA_character_
  x
}

clean_key <- function(x) {
  tolower(clean_name(x))
}

first_two_words <- function(x) {
  parts <- strsplit(clean_name(x), " ", fixed = TRUE)
  vapply(parts, function(p) {
    if (length(p) < 2) return(NA_character_)
    paste(p[1:2], collapse = " ")
  }, character(1))
}

fill_down_character <- function(x) {
  x <- as.character(x)
  last_value <- NA_character_
  for (i in seq_along(x)) {
    if (!is.na(x[i]) && x[i] != "") {
      last_value <- x[i]
    } else {
      x[i] <- last_value
    }
  }
  x
}

split_synonyms <- function(x) {
  if (is.na(x) || trimws(x) == "") return(character())
  out <- unlist(strsplit(as.character(x), "\\s*;\\s*|\\s*\\n\\s*"))
  out <- clean_name(out)
  out[!is.na(out)]
}

strip_family_english <- function(x) {
  clean_name(sub("\\s*\\(.*\\)$", "", as.character(x)))
}

# 3. BirdLife/HBW reference ---------------------------------------------------

message("Reading BirdLife/HBW checklist.")
birdlife_raw <- as.data.table(read_excel(
  birdlife_file,
  sheet = "HBW-BirdLife_v.10",
  skip = 3,
  .name_repair = "minimal"
))

birdlife <- birdlife_raw[
  ,
  .(
    source = "BirdLife_HBW_v10",
    source_row = .I,
    sequence = as.character(`Seq.`),
    order_name = clean_name(Order),
    family_name = clean_name(`Family name`),
    family_common_name = clean_name(Family),
    subfamily = clean_name(Subfamily),
    tribe = clean_name(Tribe),
    common_name = clean_name(`Common name`),
    scientific_name = clean_name(`Scientific name`),
    scientific_name_key = clean_key(`Scientific name`),
    authority = clean_name(Authority),
    iucn_category_2025 = clean_name(`2025 IUCN Red List category`),
    synonyms_raw = as.character(Synonyms),
    alternative_common_names = as.character(`Alternative common names`),
    taxonomic_sources = as.character(`Taxonomic source(s)`),
    SISRecID = as.character(SISRecID),
    SpcRecID = as.character(birdlife_raw[["SpcRecID\r\n(used before SISRecID)"]]),
    SubsppID = as.character(SubsppID)
  )
]

birdlife[
  ,
  c("order_name", "family_name", "family_common_name", "subfamily", "tribe") :=
    lapply(.SD, fill_down_character),
  .SDcols = c("order_name", "family_name", "family_common_name", "subfamily", "tribe")
]

birdlife[, parent_species_name := fifelse(
  !is.na(scientific_name) &
    !is.na(SISRecID) &
    is.na(SubsppID) &
    !is.na(common_name),
  scientific_name,
  NA_character_
)]
birdlife[, parent_species_name := fill_down_character(parent_species_name)]
birdlife[, parent_species_name_key := clean_key(parent_species_name)]

birdlife[, source_rank := fcase(
  !is.na(SubsppID), "subspecies",
  !is.na(SISRecID) & !is.na(common_name), "species",
  !is.na(SpcRecID), "legacy_species_record",
  !is.na(scientific_name), "name_record",
  default = NA_character_
)]

birdlife_taxa <- birdlife[
  !is.na(scientific_name),
  .(
    source,
    source_row,
    source_rank,
    sequence,
    order_name,
    family_name,
    family_common_name,
    subfamily,
    tribe,
    parent_species_name,
    parent_species_name_key,
    common_name,
    scientific_name,
    scientific_name_key,
    authority,
    iucn_category_2025,
    synonyms_raw,
    alternative_common_names,
    taxonomic_sources,
    SISRecID,
    SpcRecID,
    SubsppID
  )
]

birdlife_species_names <- birdlife_taxa[
  source_rank == "species",
  .(
    source = "BirdLife_HBW_v10",
    birdlife_species_name = scientific_name,
    birdlife_species_name_key = scientific_name_key,
    birdlife_search_name = scientific_name,
    birdlife_search_name_key = scientific_name_key,
    birdlife_search_name_type = "species_scientific_name",
    birdlife_search_rank = "species",
    order_name,
    family_name,
    common_name,
    SISRecID,
    SpcRecID,
    SubsppID = NA_character_
  )
]

birdlife_subspecies_names <- birdlife_taxa[
  source_rank == "subspecies",
  .(
    source = "BirdLife_HBW_v10",
    birdlife_species_name = parent_species_name,
    birdlife_species_name_key = parent_species_name_key,
    birdlife_search_name = scientific_name,
    birdlife_search_name_key = scientific_name_key,
    birdlife_search_name_type = "subspecies_scientific_name",
    birdlife_search_rank = "subspecies",
    order_name,
    family_name,
    common_name,
    SISRecID = NA_character_,
    SpcRecID = NA_character_,
    SubsppID
  )
]

birdlife_synonym_names <- birdlife_taxa[
  source_rank == "species",
  .(birdlife_search_name = split_synonyms(synonyms_raw)),
  by = .(
    source,
    birdlife_species_name = scientific_name,
    birdlife_species_name_key = scientific_name_key,
    order_name,
    family_name,
    common_name,
    SISRecID,
    SpcRecID
  )
]

birdlife_synonym_names[, birdlife_search_name := clean_name(birdlife_search_name)]
birdlife_synonym_names <- birdlife_synonym_names[!is.na(birdlife_search_name)]
birdlife_synonym_names[, `:=`(
  birdlife_search_name_key = clean_key(birdlife_search_name),
  birdlife_search_name_type = "species_synonym",
  birdlife_search_rank = "synonym",
  SubsppID = NA_character_
)]

birdlife_names <- rbindlist(
  list(
    birdlife_species_names,
    birdlife_subspecies_names,
    birdlife_synonym_names
  ),
  fill = TRUE
)

birdlife_names <- unique(
  birdlife_names,
  by = c("birdlife_species_name_key", "birdlife_search_name_key", "birdlife_search_name_type")
)

# 4. eBird/Clements reference names ------------------------------------------

message("Reading Clements/eBird.")
clements_raw <- fread(
  clements_file,
  encoding = "UTF-8",
  na.strings = c("", "NA"),
  quote = "\""
)

clements_raw[, family_clean := strip_family_english(family)]

clements_names <- clements_raw[
  category %chin% c("species", "subspecies") &
    !is.na(`scientific name`),
  .(
    source = "Clements_eBird_2025",
    source_sheet = "eBird-Clements integrated checklist 2025",
    source_row = .I,
    source_rank = clean_name(category),
    scientific_name = clean_name(`scientific name`),
    scientific_name_key = clean_key(`scientific name`),
    parent_species_name = fifelse(
      category == "subspecies",
      first_two_words(`scientific name`),
      clean_name(`scientific name`)
    ),
    parent_species_name_key = clean_key(fifelse(
      category == "subspecies",
      first_two_words(`scientific name`),
      clean_name(`scientific name`)
    )),
    common_name = clean_name(`English name`),
    authority = clean_name(authority),
    avibase_id = as.character(`taxon concept ID`),
    name_id = NA_character_,
    species_code = as.character(species_code),
    row_sort = as.character(`sort v2025`)
  )
]

# 5. Avibase reference names --------------------------------------------------

message("Reading Avibase bibliographic sheets.")
avibase_sheets <- c("AviList 2025", "Clements 2025", "IOC 15.1", "HBW-Birdlife 10")

avibase_names <- rbindlist(
  lapply(avibase_sheets, function(sheet_name) {
    x <- as.data.table(read_excel(avibase_file, sheet = sheet_name))
    x <- x[
      level %chin% c("species", "subsp") &
        !is.na(sci_name) &
        !is.na(avibase_id) &
        avibase_id != "n/a"
    ]
    data.table(
      source = paste0("Avibase_", gsub("[^A-Za-z0-9]+", "_", sheet_name)),
      source_sheet = sheet_name,
      source_row = seq_len(nrow(x)),
      source_rank = clean_name(x$level),
      scientific_name = clean_name(x$sci_name),
      scientific_name_key = clean_key(x$sci_name),
      parent_species_name = fifelse(
        x$level == "subsp",
        first_two_words(x$sci_name),
        clean_name(x$sci_name)
      ),
      parent_species_name_key = clean_key(fifelse(
        x$level == "subsp",
        first_two_words(x$sci_name),
        clean_name(x$sci_name)
      )),
      common_name = NA_character_,
      authority = clean_name(x$authors),
      avibase_id = as.character(x$avibase_id),
      name_id = as.character(x$name_id),
      species_code = as.character(x$species_code),
      row_sort = as.character(x$sort_order),
      year = as.character(x$year),
      publication_name = as.character(x$publication_name),
      original_genus = as.character(x$original_genus),
      protonym = as.character(x$protonym)
    )
  }),
  fill = TRUE
)

avibase_names <- avibase_names[order(avibase_id, source, source_rank, scientific_name)]

# HBW-BirdLife rows provide the Avibase-ID-to-BirdLife-code bridge.
hbw_code_by_avibase_id <- avibase_names[
  source == "Avibase_HBW_Birdlife_10",
  .(
    avibase_id,
    hbw_birdlife_rank = source_rank,
    hbw_birdlife_name = scientific_name,
    hbw_birdlife_name_key = scientific_name_key,
    hbw_birdlife_name_id = name_id,
    hbw_birdlife_name_code = species_code
  )
]

avibase_names <- merge(
  avibase_names,
  hbw_code_by_avibase_id,
  by = "avibase_id",
  all.x = TRUE,
  sort = FALSE
)

clements_names <- merge(
  clements_names,
  hbw_code_by_avibase_id,
  by = "avibase_id",
  all.x = TRUE,
  sort = FALSE
)

taxonomy_source_names <- rbindlist(
  list(clements_names, avibase_names),
  fill = TRUE
)[!is.na(scientific_name)]

# Keep duplicate names across sources because IDs/ranks may differ by checklist.
setcolorder(
  taxonomy_source_names,
  intersect(
    c(
      "source",
      "source_sheet",
      "source_row",
      "source_rank",
      "scientific_name",
      "scientific_name_key",
      "parent_species_name",
      "parent_species_name_key",
      "common_name",
      "authority",
      "avibase_id",
      "name_id",
      "hbw_birdlife_rank",
      "hbw_birdlife_name",
      "hbw_birdlife_name_key",
      "hbw_birdlife_name_id",
      "hbw_birdlife_name_code",
      "row_sort",
      "year",
      "publication_name",
      "original_genus",
      "protonym"
    ),
    names(taxonomy_source_names)
  )
)

# 6. Final long-format outputs ------------------------------------------------

birdlife_reference <- birdlife_names[
  ,
  .(
    source,
    search_name = birdlife_search_name,
    search_name_key = birdlife_search_name_key,
    search_name_type = birdlife_search_name_type,
    search_rank = birdlife_search_rank,
    target_birdlife_name = birdlife_species_name,
    target_birdlife_name_key = birdlife_species_name_key,
    SISRecID,
    SpcRecID,
    SubsppID
  )
]

avibase_reference <- taxonomy_source_names[
  ,
  .(
    source,
    source_rank,
    search_name = scientific_name,
    search_name_key = scientific_name_key,
    parent_species_name,
    parent_species_name_key,
    avibase_id,
    name_id,
    hbw_birdlife_rank,
    hbw_birdlife_name,
    hbw_birdlife_name_key,
    hbw_birdlife_name_id,
    hbw_birdlife_name_code,
    row_sort
  )
]

setorder(birdlife_reference, target_birdlife_name_key, search_name_type, search_name_key)
setorder(avibase_reference, avibase_id, source, source_rank, search_name_key)

fwrite(birdlife_reference, birdlife_reference_file, sep = "\t")
fwrite(avibase_reference, avibase_reference_file, sep = "\t")

message("BirdLife reference table: ", birdlife_reference_file)
message("Avibase/eBird reference table: ", avibase_reference_file)
message("BirdLife reference rows: ", nrow(birdlife_reference))
message("Avibase/eBird reference rows: ", nrow(avibase_reference))
